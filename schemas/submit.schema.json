{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hearthrun:submit:v1",
  "title": "HearthRun submit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "op",
    "request_id",
    "profile_id",
    "stage_id",
    "argv",
    "wall_ms"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "op": {
      "const": "submit"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "argv": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "wall_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    }
  },
  "$comment": "Parser additionally rejects duplicate keys and enforces UTF-8 byte aggregate argv limits; JSON Schema maxLength counts characters."
}
