{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Committed result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "job_id",
    "status",
    "cleanup_confirmed",
    "artifacts",
    "policy_sha256",
    "environment_id"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "INTERRUPTED"
      ]
    },
    "cleanup_confirmed": {
      "const": true
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "signal": {
      "type": [
        "integer",
        "null"
      ]
    },
    "stdout_truncated": {
      "type": "boolean"
    },
    "stderr_truncated": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 33554432
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$comment": "Byte-sum, path grammar and actual kernel cleanup must be validated outside JSON Schema; this schema alone proves no isolation."
}
